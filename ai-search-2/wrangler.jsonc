{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-search-2",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "9a5140a7b53f4945b56fbb60f40e5c1c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-search-2-db",
      "database_id": "21f227c2-514b-4833-8eb6-4ab30912daf7"
    }
  ]
}
