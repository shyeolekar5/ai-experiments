{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-search-2",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      // TODO: fill in after running `npx wrangler kv namespace create ai-search-2-kv`
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-search-2-db",
      // TODO: fill in after running `npx wrangler d1 create ai-search-2-db`
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
